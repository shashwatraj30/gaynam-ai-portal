<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GYANAM AI — National Law University, Jodhpur | Powered by Kelyvo</title>
  
  <!-- Modern Executive Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            serif: ['"Source Serif 4"', 'Georgia', 'serif'],
            outfit: ['"Outfit"', 'sans-serif'],
            display: ['"Outfit"', 'sans-serif'],
          },
          colors: {
            court: {
              navy: '#081428',
              navyDeep: '#040B17',
              navyLight: '#0E2242',
              cream: '#FDFCF9',
              gold: '#C59B27',
              goldHover: '#B2881E',
              goldLight: '#FBF4DD',
              slate: '#475569',
              border: '#E2E8F0',
              cardBg: '#FFFFFF',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #F8F9FA;
      color: #0F172A;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .legal-serif {
      font-family: 'Source Serif 4', Georgia, serif;
      line-height: 1.8;
    }
    .court-shadow {
      box-shadow: 0 4px 20px -2px rgba(8, 20, 40, 0.06), 0 2px 6px -1px rgba(8, 20, 40, 0.03);
    }
    .court-shadow-lg {
      box-shadow: 0 16px 36px -4px rgba(8, 20, 40, 0.12), 0 6px 16px -2px rgba(8, 20, 40, 0.06);
    }
    
    /* Grand Header Campus Banner */
    .header-campus-hero {
      position: relative;
      background: 
        linear-gradient(90deg, rgba(4, 11, 23, 0.93) 0%, rgba(4, 11, 23, 0.82) 32%, rgba(4, 11, 23, 0.40) 60%, rgba(4, 11, 23, 0.72) 100%),
        url('/static/nlu_campus_real.jpg');
      background-size: cover;
      background-position: center 36%;
      background-repeat: no-repeat;
    }

    /* Seamless Collapsible Campus Banner */
    #grand-hero-container {
      transition: max-height 0.48s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.35s ease,
                  transform 0.48s cubic-bezier(0.16, 1, 0.3, 1);
      max-height: 800px;
      transform: translateY(0);
      opacity: 1;
      transform-origin: top center;
      will-change: max-height, opacity, transform;
      overflow: hidden;
    }

    #grand-hero-container.hero-collapsed {
      max-height: 0 !important;
      opacity: 0 !important;
      transform: translateY(-36px);
      pointer-events: none;
      visibility: hidden;
      border-bottom-width: 0 !important;
    }

    /* Sticky Navbar Transitions */
    #sticky-navbar {
      transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    /* Sleek Sidebar Scrollbar */
    #app-sidebar::-webkit-scrollbar,
    #live-cases-wrapper::-webkit-scrollbar,
    #studio-solved-cases-container::-webkit-scrollbar {
      width: 4px;
    }
    #app-sidebar::-webkit-scrollbar-track,
    #live-cases-wrapper::-webkit-scrollbar-track,
    #studio-solved-cases-container::-webkit-scrollbar-track {
      background: transparent;
    }
    #app-sidebar::-webkit-scrollbar-thumb,
    #live-cases-wrapper::-webkit-scrollbar-thumb,
    #studio-solved-cases-container::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
    }
    #app-sidebar::-webkit-scrollbar-thumb:hover,
    #live-cases-wrapper::-webkit-scrollbar-thumb:hover,
    #studio-solved-cases-container::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    /* Retractable / Auto-Collapsing Sidebar Mode */
    @media (min-width: 1024px) {
      #app-sidebar {
        transition: width 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
      }
      #app-sidebar.sidebar-retracted {
        width: 76px !important;
        overflow-x: hidden !important;
      }
      #app-sidebar.sidebar-retracted:hover {
        width: 320px !important;
        position: fixed !important;
        top: 0;
        bottom: 0;
        left: 0;
        height: 100vh;
        z-index: 60;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.1);
      }
      #app-sidebar.sidebar-retracted:not(:hover) .sidebar-expanded-view {
        display: none !important;
      }
      #app-sidebar.sidebar-retracted:hover .sidebar-expanded-view {
        display: flex !important;
      }
      #app-sidebar.sidebar-retracted:not(:hover) .sidebar-rail-view {
        display: flex !important;
      }
      #app-sidebar.sidebar-retracted:hover .sidebar-rail-view {
        display: none !important;
      }
      #app-sidebar:not(.sidebar-retracted) .sidebar-rail-view {
        display: none !important;
      }
      #app-sidebar:not(.sidebar-retracted) .sidebar-expanded-view {
        display: flex !important;
      }
    }

    /* Editable Judicial Decree Canvas Styling */
    [contenteditable="true"]:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(197, 155, 39, 0.4);
      background-color: #FFFFFF !important;
    }

    /* Print styling */
    @media print {
      body * { visibility: hidden; }
      #printable-judicial-decree, #printable-judicial-decree * { visibility: visible; }
      #printable-judicial-decree {
        position: absolute; left: 0; top: 0; width: 100%;
        color: black !important; background: white !important;
        box-shadow: none !important; border: none !important;
        padding: 0 !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col lg:flex-row bg-[#F8FAFC] text-[#0F172A] antialiased selection:bg-court-gold selection:text-white font-sans">

  <!-- ==================== MODERN RETRACTABLE SIDEBAR ==================== -->
  <!-- Mobile Drawer Backdrop Overlay -->
  <div id="mobile-sidebar-backdrop" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-40 hidden lg:hidden"></div>

  <aside id="app-sidebar" class="hidden lg:flex fixed lg:sticky inset-y-0 left-0 z-50 lg:z-40 w-72 sm:w-80 lg:w-80 bg-court-navyDeep text-slate-200 border-r border-slate-800/80 flex-col shrink-0 h-screen transition-all duration-300 shadow-2xl overflow-y-auto">
    
    <!-- 1. EXPANDED SIDEBAR VIEW (Shown by default, or on hover when retracted) -->
    <div class="sidebar-expanded-view flex flex-col flex-1 min-h-0">
      
      <!-- Top Branding & Institutional Seal (Enlarged Logo) -->
      <div class="p-4 sm:p-5 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center space-x-3.5 cursor-pointer" onclick="switchTab('tab-research')">
          <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-500 via-amber-300 to-amber-600 p-0.5 shadow-xl shrink-0">
            <img src="/static/gyanam_emblem_transparent.png" alt="Gyanam Seal" class="w-full h-full object-cover rounded-[14px] bg-court-navyDeep">
            <div class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-court-navyDeep flex items-center justify-center shadow" title="AI Verification Active">
              <span class="text-[9px] font-black text-white">✓</span>
            </div>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-outfit font-black text-2xl tracking-tight text-white">GYANAM</span>
              <span class="font-outfit font-black text-2xl text-amber-400">AI</span>
            </div>
            <div class="text-[9.5px] font-black text-amber-300/90 tracking-widest uppercase font-outfit">
              JUDICIAL INTELLIGENCE
            </div>
            <div class="flex items-center gap-1.5 mt-1 pt-1 border-t border-white/10">
              <span class="text-[9px] text-slate-400 font-medium">Powered by</span>
              <img src="/static/kelyvo_logo.png" alt="Kelyvo" class="h-3 w-auto object-contain rounded bg-black/60 px-0.5">
              <span class="text-[9.5px] font-black text-amber-300 font-outfit">KELYVO</span>
            </div>
          </div>
        </div>
        <div class="flex items-center space-x-1">
          <button onclick="toggleSidebarRetract()" class="hidden lg:flex text-slate-400 hover:text-white hover:bg-white/10 p-1.5 rounded-lg transition" title="Toggle Auto-Retract (Wide Screen Mode)" id="sidebar-retract-btn-header">
            <span class="text-xs">⇤</span>
          </button>
          <button onclick="toggleMobileSidebar()" class="lg:hidden text-slate-400 hover:text-white p-1 rounded-lg">
            ✕
          </button>
        </div>
      </div>

      <!-- Institutional Campus Photograph Badge Card -->
      <div class="px-4 py-3 border-b border-white/10">
        <div class="relative rounded-2xl overflow-hidden border border-white/15 shadow-md group">
          <img src="/static/nlu_campus_real.jpg" alt="NLU Jodhpur Campus" class="w-full h-28 object-cover group-hover:scale-105 transition-transform duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-court-navyDeep via-court-navyDeep/60 to-transparent flex items-end p-2.5">
            <div class="flex items-center space-x-2 w-full">
              <img src="/static/nluj_seal.png" alt="NLUJ Seal" class="w-7 h-7 rounded-full bg-white/95 p-0.5 shadow-sm shrink-0">
              <div class="min-w-0 flex-1">
                <div class="text-[11px] font-extrabold text-white leading-tight truncate font-outfit">
                  National Law University, Jodhpur
                </div>
                <div class="text-[9.5px] font-semibold text-amber-300/90 truncate">
                  ज्ञानम् परमम् ध्येयम् • CJLT
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Active User / Judicial Role Card in Sidebar -->
      <div class="p-3.5 border-b border-white/10 bg-white/[0.02]">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-black uppercase tracking-widest text-slate-400 font-outfit">SESSION ROLE</span>
          <button onclick="openAuthModal()" class="text-[10px] font-bold text-amber-300 hover:text-white bg-white/10 hover:bg-white/20 px-2 py-0.5 rounded-lg transition flex items-center gap-1 border border-white/15" title="Switch Role">
            <span>Switch</span> <span>⎋</span>
          </button>
        </div>
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-xl bg-amber-400/20 border border-amber-400/40 flex items-center justify-center text-sm shrink-0" id="header-user-icon">
            ⚖️
          </div>
          <div class="min-w-0 flex-1">
            <div id="header-user-name" class="text-xs font-bold text-white truncate leading-tight">Hon'ble Mr. Justice R.K. Sharma</div>
            <div id="header-user-badge" class="text-[10px] font-medium text-amber-300/90 truncate">High Court Bench • HC-RAJ-882</div>
          </div>
        </div>
      </div>

      <!-- Navigation Links Menu (Bigger, Better Font) -->
      <nav class="p-3 space-y-1.5 font-outfit">
        <div class="px-3 pt-2 pb-1 text-[11px] font-black uppercase tracking-wider text-slate-400">WORKSTATIONS</div>
        
        <button onclick="switchTab('tab-dashboard')" id="btn-tab-dashboard" class="tab-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-semibold transition-all text-slate-300 hover:text-white hover:bg-white/10 text-left">
          <div class="flex items-center space-x-3">
            <span class="text-lg">📊</span>
            <span class="tracking-tight">Dashboard</span>
          </div>
          <span id="nav-badge-dashboard" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-white/10 text-slate-300">Overview</span>
        </button>

        <button onclick="switchTab('tab-research')" id="btn-tab-research" class="tab-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-bold transition-all bg-amber-400 text-court-navy shadow-md text-left">
          <div class="flex items-center space-x-3">
            <span class="text-lg">🏛️</span>
            <span class="tracking-tight">Search Cases</span>
          </div>
          <span id="nav-badge-research" class="text-[10px] font-mono px-2 py-0.5 rounded bg-court-navy/20 font-black">1.18L</span>
        </button>

        <button onclick="switchTab('tab-citation')" id="btn-tab-citation" class="tab-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-semibold transition-all text-slate-300 hover:text-white hover:bg-white/10 text-left">
          <div class="flex items-center space-x-3">
            <span class="text-lg">🔍</span>
            <span class="tracking-tight">Verify Citation</span>
          </div>
          <span id="nav-badge-citation" class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">Sec. 8</span>
        </button>

        <button onclick="switchTab('tab-intake')" id="btn-tab-intake" class="tab-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-semibold transition-all text-slate-300 hover:text-white hover:bg-white/10 text-left">
          <div class="flex items-center space-x-3">
            <span class="text-lg">📁</span>
            <span class="tracking-tight">Upload Case</span>
          </div>
          <span id="nav-badge-intake" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-white/10 text-slate-300">Upload</span>
        </button>

        <button onclick="switchTab('tab-studio')" id="btn-tab-studio" class="tab-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-semibold transition-all text-slate-300 hover:text-white hover:bg-white/10 text-left">
          <div class="flex items-center space-x-3">
            <span class="text-lg">⚖️</span>
            <span class="tracking-tight">Draft Judgment</span>
          </div>
          <span id="nav-badge-studio" class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-amber-400/20 text-amber-300">Draft</span>
        </button>

        <button onclick="switchTab('tab-graph')" id="btn-tab-graph" class="tab-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-semibold transition-all text-slate-300 hover:text-white hover:bg-white/10 text-left">
          <div class="flex items-center space-x-3">
            <span class="text-lg">🔗</span>
            <span class="tracking-tight">Precedent History</span>
          </div>
          <span id="nav-badge-graph" class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300">History</span>
        </button>

        <button onclick="switchTab('tab-audit')" id="btn-tab-audit" class="tab-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-semibold transition-all text-slate-300 hover:text-white hover:bg-white/10 text-left">
          <div class="flex items-center space-x-3">
            <span class="text-lg">🛡️</span>
            <span class="tracking-tight">Audit &amp; Security</span>
          </div>
          <span id="nav-badge-audit" class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300">Security</span>
        </button>

        <div class="pt-3 px-3 pb-1 text-[11px] font-black uppercase tracking-wider text-slate-400">INSTITUTIONAL</div>

        <button onclick="openDocsModal('TENDER_COMPLIANCE_DOSSIER.md')" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/10 text-left transition">
          <span class="text-lg">📋</span>
          <span class="tracking-tight">Tender Dossier</span>
        </button>
      </nav>

      <!-- ==================== LIVE JUDICIAL DISPATCH IN SIDEBAR ==================== -->
      <div class="p-3.5 border-t border-white/10 bg-white/[0.02] space-y-2">
        <div class="flex items-center justify-between px-1">
          <div class="flex items-center space-x-2">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
            </span>
            <span class="font-outfit font-extrabold text-xs text-white uppercase tracking-wider">
              Live Judicial Dispatch
            </span>
          </div>
          <button onclick="triggerCourtSync()" id="btn-sync-feed" class="text-[10px] font-bold text-amber-300 hover:text-white bg-white/10 hover:bg-white/20 px-2 py-0.5 rounded-md transition border border-white/10 flex items-center gap-1" title="Sync Live Decrees">
            <span>↻</span> <span>Sync</span>
          </button>
        </div>

        <div class="flex items-center justify-between text-[10px] px-1 text-slate-400 font-medium">
          <span>eCourts Cause List Stream</span>
          <span id="live-stream-counter" class="font-mono text-emerald-400 font-bold">● Active Feed</span>
        </div>

        <!-- Live Cases Stream Container -->
        <div id="live-cases-wrapper" class="max-h-56 overflow-y-auto space-y-2 pr-0.5">
          <div id="live-cases-stream-container" class="space-y-2">
            <div class="p-3 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-slate-400 text-center">
              Connecting to live judicial cause list feed...
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar Footer: Telemetry & Air Gap -->
      <div class="p-3.5 border-t border-white/10 bg-black/20 space-y-2 text-xs mt-auto">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span id="header-db-counter" class="font-mono text-[11px] font-bold text-white">1,17,988 Active</span>
          </div>
          <button onclick="triggerCourtSync()" id="btn-sync-trigger" class="text-[10.5px] text-amber-300 hover:text-white bg-white/10 hover:bg-white/20 px-2 py-0.5 rounded-md font-bold transition">
            ↻ Sync
          </button>
        </div>
        <div class="flex items-center space-x-2 text-[10px] text-slate-400 font-medium">
          <span class="text-emerald-400">🔒</span>
          <span>DPDP 2023 Air-Gapped Local AI</span>
        </div>
        <div class="flex items-center justify-between pt-1 border-t border-white/10 text-[10px] text-slate-400 font-medium">
          <div class="flex items-center gap-1.5">
            <img src="/static/kelyvo_logo.png" alt="Kelyvo" class="h-3.5 w-auto rounded bg-black px-1 py-0.5">
            <span class="font-bold text-slate-300">Powered by Kelyvo</span>
          </div>
          <span class="text-[9px] text-slate-500 font-mono">v2.5.0</span>
        </div>
      </div>
    </div>

    <!-- 2. MINI RAIL VIEW (Shown when sidebar is retracted and not hovered) -->
    <div class="sidebar-rail-view hidden flex-col items-center py-5 space-y-6 text-slate-200 w-full min-h-screen">
      
      <!-- Mini Emblem (40px) -->
      <div class="relative w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 p-0.5 shadow-md cursor-pointer" onclick="switchTab('tab-research')" title="Gyanam AI (Click to Open)">
        <img src="/static/gyanam_emblem_transparent.png" alt="Gyanam Seal" class="w-full h-full object-cover rounded-[10px] bg-court-navyDeep">
        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 border border-court-navyDeep flex items-center justify-center">
          <span class="text-[7px] text-white font-black">✓</span>
        </div>
      </div>

      <!-- Expand Pin Button -->
      <button onclick="toggleSidebarRetract()" class="w-9 h-9 rounded-xl bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white flex items-center justify-center text-sm transition" title="Pin Sidebar (Expanded View)">
        📌
      </button>

      <!-- Mini Workstation Icons -->
      <div class="flex flex-col items-center space-y-3 pt-2">
        <button onclick="switchTab('tab-research')" class="w-10 h-10 rounded-xl bg-amber-400 text-court-navy flex items-center justify-center text-lg shadow transition" title="Precedent Search (1.18L)">
          🏛️
        </button>
        <button onclick="switchTab('tab-intake')" class="w-10 h-10 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 flex items-center justify-center text-lg transition" title="Pleading Intake & Neural OCR">
          📑
        </button>
        <button onclick="switchTab('tab-studio')" class="w-10 h-10 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 flex items-center justify-center text-lg transition" title="15-Section Judgment Studio">
          ⚖️
        </button>
        <button onclick="switchTab('tab-graph')" class="w-10 h-10 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 flex items-center justify-center text-lg transition" title="Precedent Lineage Network">
          🔗
        </button>
        <button onclick="switchTab('tab-audit')" class="w-10 h-10 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 flex items-center justify-center text-lg transition" title="Audit & DPDP Cryptographic Ledger">
          🛡️
        </button>
        <button onclick="openDocsModal('TENDER_COMPLIANCE_DOSSIER.md')" class="w-10 h-10 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 flex items-center justify-center text-lg transition" title="Tender Compliance Dossier">
          📋
        </button>
      </div>

      <!-- Mini Live Radar Dot -->
      <div class="mt-auto pb-4 flex flex-col items-center space-y-2">
        <div class="relative flex h-3 w-3 cursor-pointer" onclick="triggerCourtSync()" title="eCourts Live Stream Connected (Click to Sync)">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
        </div>
      </div>

    </div>

  </aside>

  <!-- ==================== MAIN APPLICATION CANVAS ==================== -->
  <div class="flex-1 flex flex-col min-w-0 min-h-screen overflow-y-auto">

    <!-- TOP CLEAN APP BAR (Uncluttered, Dignified & Structured) -->
    <header class="bg-white border-b border-slate-200 px-3 sm:px-6 py-2.5 sm:py-3.5 flex items-center justify-between shadow-xs sticky top-0 z-30 gap-2">
      
      <!-- Left: Mobile toggle & Clean Institutional Breadcrumb -->
      <div class="flex items-center space-x-2 sm:space-x-3 shrink-0 min-w-0">
