      <!-- ==================== TAB 1: PRECEDENT SEARCH ==================== -->
      <section id="tab-research" class="tab-content space-y-8">
        
        <!-- 1. EXPANSIVE GRAND JUDICIAL SEARCH HERO (CENTER STAGE & ENLARGED) -->
        <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 lg:p-14 shadow-lg border-2 border-slate-200/90 relative overflow-hidden text-center">
          <!-- Ambient Glow Background -->
          <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[650px] h-[650px] bg-gradient-to-b from-amber-400/15 via-amber-200/5 to-transparent rounded-full blur-3xl pointer-events-none"></div>

          <div class="max-w-4xl mx-auto space-y-3 sm:space-y-4 relative z-10">
            <!-- Badges: Judicial Corpus + Powered by Kelyvo -->
            <div class="flex flex-wrap items-center justify-center gap-2">
              <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 rounded-full bg-amber-50 border border-amber-300 text-amber-950 text-xs sm:text-sm font-black tracking-wide shadow-xs">
                <span class="text-base">🏛️</span>
                <span id="search-fts-badge">1,18,003 Judgments Indexed • SC &amp; 25 High Courts</span>
              </div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-950 border border-slate-800 text-white text-xs font-bold shadow-xs">
                <img src="/static/kelyvo_logo.png" alt="Kelyvo Logo" class="h-4 w-auto object-contain">
                <span class="text-[10px] text-slate-300 font-sans">Powered by</span>
                <span class="text-[11px] font-black text-amber-300 tracking-wider font-outfit">KELYVO</span>
              </div>
            </div>

            <!-- Grand Headline -->
            <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black font-outfit text-court-navy tracking-tight leading-tight">
              Indian Legal Research &amp; Judgment Assistant
            </h2>
            
            <!-- Subtitle -->
            <p class="text-xs sm:text-base lg:text-lg text-slate-600 max-w-2xl mx-auto font-medium leading-relaxed">
              Find binding precedents, detect overruled law, and extract canonical judicial ratios across India's largest verified legal corpus.
            </p>

            <!-- Grand Search Bar (Responsive Fluid Layout - Never Squished on Mobile) -->
            <div class="pt-2 sm:pt-4 max-w-3xl mx-auto space-y-2">
              <div class="relative flex items-center bg-slate-50/90 hover:bg-white focus-within:bg-white border-2 border-slate-300 hover:border-slate-400 focus-within:border-court-navy rounded-2xl sm:rounded-3xl p-1.5 sm:p-2.5 transition-all duration-200 shadow-md hover:shadow-lg focus-within:ring-4 focus-within:ring-court-navy/10 gap-1 sm:gap-2">
                <span class="pl-2 sm:pl-3 text-lg sm:text-2xl text-slate-400 shrink-0">🔍</span>
                <input type="text" id="search-input" 
                       value=""
                       onkeydown="if(event.key==='Enter') executeSearch();"
                       placeholder="Search cases, laws, citations, judges or legal issues..."
                       class="flex-1 min-w-0 bg-transparent py-2.5 sm:py-3.5 px-1 sm:px-2 text-sm sm:text-base lg:text-lg text-court-navy placeholder-slate-400 outline-none font-semibold">
                <button onclick="document.getElementById('search-input').value=''; document.getElementById('search-input').focus();" class="p-1.5 text-slate-400 hover:text-slate-600 text-sm sm:text-base shrink-0 cursor-pointer" title="Clear Search">
                  ✕
                </button>
                <button onclick="executeSearch()" class="px-3.5 sm:px-8 py-2 sm:py-3 rounded-xl sm:rounded-2xl bg-court-navy hover:bg-court-navyLight text-white font-extrabold text-xs sm:text-sm md:text-base tracking-wide shadow-md transition flex items-center gap-1 sm:gap-1.5 shrink-0 cursor-pointer transform hover:scale-[1.02]">
                  <span>Search</span>
                  <span class="text-amber-400">➔</span>
                </button>
              </div>
              <p class="text-[11px] sm:text-xs md:text-sm text-slate-500 font-medium text-center sm:text-left px-1">
                Search cases, laws, citations, judges or legal issues. (Natural language, statutes, or SCC/SCR citations)
              </p>
            </div>

            <!-- Quick Popular Search Topic Pills -->
            <div class="flex flex-wrap items-center justify-center gap-2 pt-2 text-xs">
              <span class="text-slate-400 font-bold text-xs uppercase tracking-wider">Quick Benchmark Queries:</span>
              <button onclick="applyQuickSearch('principles of natural justice in disciplinary proceedings')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 hover:border-amber-300 transition font-semibold text-xs cursor-pointer">
                ⚡ Natural Justice (ECIL)
              </button>
              <button onclick="applyQuickSearch('Right to Privacy fundamental right Article 21 ADM Jabalpur overruled')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 hover:border-amber-300 transition font-semibold text-xs cursor-pointer">
                🛡️ Privacy (Puttaswamy)
              </button>
              <button onclick="applyQuickSearch('Section 139 Negotiable Instruments Act presumption legally enforceable debt')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 hover:border-amber-300 transition font-semibold text-xs cursor-pointer">
                ⚖️ Section 138 NI Act (Rangappa)
              </button>
              <button onclick="applyQuickSearch('maintainability of writ petition alternative statutory remedy')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 hover:border-amber-300 transition font-semibold text-xs cursor-pointer">
                🏛️ Writ Remedy (Whirlpool)
              </button>
              <button onclick="applyQuickSearch('scope of judicial intervention section 34 patent illegality')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 hover:border-amber-300 transition font-semibold text-xs cursor-pointer">
                🏢 Arbitration Patent Illegality
              </button>
            </div>

            <!-- Filter Drawer Toggle -->
            <div class="pt-2">
              <button onclick="toggleAdvancedFilters()" id="btn-toggle-filters" class="text-xs font-bold text-slate-600 hover:text-court-navy inline-flex items-center gap-1.5 transition cursor-pointer">
                <span>⚙️ Filter by Jurisdiction, Bench or Precedent Status</span>
                <span id="filter-toggle-chevron">▼</span>
              </button>
            </div>

            <!-- Advanced Filters Drawer -->
            <div id="advanced-filters-drawer" class="hidden text-left pt-4 border-t border-slate-200 mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs max-w-3xl mx-auto">
              <div>
                <label class="block font-bold text-court-navy mb-1 text-[11px] uppercase tracking-wider">Court Jurisdiction</label>
                <select id="filter-court" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-navy font-semibold text-xs outline-none focus:border-court-navy">
                  <option value="ALL">All Indian Courts (SC + All 25 High Courts)</option>
                  <option value="Supreme Court of India">Supreme Court of India</option>
                  <option value="High Court of Rajasthan">High Court of Rajasthan (Jodhpur &amp; Jaipur)</option>
                  <option value="High Court of Delhi">High Court of Delhi</option>
                  <option value="High Court of Bombay">High Court of Bombay</option>
                  <option value="High Court of Gujarat">High Court of Gujarat</option>
                  <option value="High Court of Judicature at Madras">High Court of Madras</option>
                </select>
              </div>
              <div>
                <label class="block font-bold text-court-navy mb-1 text-[11px] uppercase tracking-wider">Precedent Health</label>
                <select id="filter-status" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-navy font-semibold text-xs outline-none focus:border-court-navy">
                  <option value="ALL">All Precedent Categories</option>
                  <option value="FOLLOWED">🟢 Followed / Active Binding Law</option>
                  <option value="DISTINGUISHED">🟡 Distinguished / Qualified Law</option>
                  <option value="OVERRULED">🔴 Overruled Only (Risk Warnings)</option>
                </select>
              </div>
              <div>
                <label class="block font-bold text-court-navy mb-1 text-[11px] uppercase tracking-wider">Bench / Coram / Judge</label>
                <input type="text" id="filter-judge" placeholder="e.g. Venkatachaliah, CJI" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-navy font-semibold text-xs outline-none focus:border-court-navy">
              </div>
            </div>

          </div>
        </div>

        <!-- 2. RESEARCH WORKSPACE: BENCH BRIEF TRAY -->
        <div id="bench-brief-tray" class="hidden bg-gradient-to-r from-court-navy via-slate-900 to-court-navy text-white rounded-3xl p-6 shadow-xl border-2 border-amber-400/40 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-4">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-2xl bg-amber-400/20 border border-amber-400/40 flex items-center justify-center text-lg">
                📌
              </div>
              <div>
                <h4 class="font-outfit font-extrabold text-sm uppercase tracking-wider text-amber-300">
                  Active Research Workspace — Bench Brief (<span id="bench-brief-count">0</span>/5 Authorities Saved)
                </h4>
                <p class="text-xs text-slate-300">Pinned authorities are ready for comparative evaluation and batch-transfer to 15-Section Judgment Studio.</p>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <button onclick="transferBenchBriefToStudio()" class="px-5 py-2.5 bg-amber-400 hover:bg-amber-300 text-court-navy font-black rounded-xl text-xs shadow transition flex items-center gap-1.5 cursor-pointer">
                <span>⚖️</span> <span>Transfer All to Judgment Studio ➔</span>
              </button>
              <button onclick="clearBenchBrief()" class="px-3.5 py-2.5 bg-white/10 hover:bg-white/20 text-slate-300 rounded-xl text-xs font-bold transition cursor-pointer">
                Clear Workspace
              </button>
            </div>
          </div>
          <div id="bench-brief-items" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <!-- Pinned items dynamically injected -->
          </div>
        </div>

        <!-- 3. SEARCH RESULTS SECTION -->
        <div class="space-y-4">
          <div class="flex items-center justify-between text-sm px-1">
            <span id="results-count-text" class="font-extrabold text-court-navy text-sm sm:text-base">Ready to Search 1,18,003 Precedents</span>
            <span class="text-xs text-court-slate font-semibold hidden sm:inline">Ranked by Upper Bench Priority &amp; Article 141</span>
          </div>

          <div id="results-container" class="space-y-4">
            <!-- Initial Prompt State (Displayed before user clicks Search) -->
            <div class="bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-12 text-center court-shadow border border-court-border space-y-4">
              <div class="w-14 h-14 sm:w-16 sm:h-16 mx-auto rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-center text-2xl sm:text-3xl shadow-inner">
                ⚖️
              </div>
              <div class="max-w-md mx-auto space-y-1">
                <h3 class="font-outfit font-extrabold text-base sm:text-xl text-court-navy">Search 1.18 Lakh Authoritative Indian Decisions</h3>
                <p class="text-xs sm:text-sm text-slate-500 font-medium">Type any legal issue, section, judge, or party name above and click <strong>Search</strong> to retrieve binding precedents.</p>
              </div>
              <div class="pt-2 flex flex-wrap items-center justify-center gap-2 text-xs">
                <span class="text-slate-400 font-bold uppercase text-[10px] tracking-wider block w-full">Featured Benchmark Queries:</span>
                <button onclick="applyQuickSearch('principles of natural justice in disciplinary proceedings')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 transition font-semibold cursor-pointer text-xs">⚡ Natural Justice (ECIL)</button>
                <button onclick="applyQuickSearch('anticipatory bail Section 438 CrPC')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 transition font-semibold cursor-pointer text-xs">🛡️ Anticipatory Bail</button>
                <button onclick="applyQuickSearch('Right to Privacy fundamental right Article 21')" class="px-3.5 py-1.5 rounded-full bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-900 border border-slate-200 transition font-semibold cursor-pointer text-xs">🔒 Privacy (Article 21)</button>
              </div>
            </div>
          </div>
        </div>

      </section>

      <!-- ==================== TAB 1B: DEDICATED CITATION VERIFICATION ==================== -->
      <section id="tab-citation" class="tab-content hidden space-y-6">
        <!-- Citation Verifier Hero -->
        <div class="bg-white rounded-3xl p-4 sm:p-8 lg:p-12 court-shadow border border-court-border space-y-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-court-border pb-5">
            <div>
              <div class="flex items-center space-x-2.5">
                <span class="text-2xl">🔍</span>
                <h2 class="text-xl sm:text-2xl font-extrabold text-court-navy tracking-tight font-outfit">
                  Dedicated Judicial Citation Verifier
                </h2>
                <span class="px-3 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                  Section 8 SOW Compliance
                </span>
              </div>
              <p class="text-xs lg:text-sm text-court-slate mt-1 font-medium">
                Deterministic verification against Supreme Court &amp; High Court records. Instantly verify bench, validity, overruling history, and canonical ratio.
              </p>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200">
                100% Zero Hallucination
              </span>
            </div>
          </div>

          <!-- Citation Search Bar -->
          <div class="space-y-3">
            <div class="relative flex items-center bg-slate-50 hover:bg-white focus-within:bg-white border-2 border-slate-300 focus-within:border-court-navy rounded-2xl p-1.5 sm:p-2 transition-all shadow-sm focus-within:ring-4 focus-within:ring-court-navy/10 gap-1">
              <span class="pl-2 sm:pl-3.5 pr-1 text-lg sm:text-xl text-slate-400 shrink-0">📖</span>
              <input type="text" id="citation-input" 
                     value="(2017) 10 SCC 1"
                     placeholder="Enter citation, e.g. (2017) 10 SCC 1, (1976) 2 SCC 521..."
                     class="flex-1 min-w-0 bg-transparent py-2 sm:py-2.5 text-sm sm:text-base text-court-navy placeholder-slate-400 outline-none font-semibold font-mono">
              <button onclick="document.getElementById('citation-input').value=''; document.getElementById('citation-input').focus();" class="p-1.5 sm:p-2 text-slate-400 hover:text-slate-600 text-xs sm:text-sm shrink-0 cursor-pointer">
                ✕
              </button>
              <button onclick="executeSingleCitationVerify()" class="px-3 sm:px-6 py-2 sm:py-2.5 rounded-xl bg-court-navy hover:bg-court-navyLight text-white font-extrabold text-xs sm:text-sm tracking-wide shadow transition flex items-center gap-1.5 shrink-0 cursor-pointer">
                <span>Verify</span><span class="hidden sm:inline">Citation</span>
                <span>➔</span>
              </button>
            </div>
            
            <!-- Quick Sample Citations -->
            <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
              <span class="text-slate-400 font-bold text-[11px] uppercase tracking-wider">Tender Benchmark Citations:</span>
              <button onclick="applyCitationSample('(2017) 10 SCC 1')" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-emerald-100 text-slate-700 hover:text-emerald-900 border border-slate-200 hover:border-emerald-300 font-mono font-bold transition cursor-pointer">
                🟢 (2017) 10 SCC 1 (Puttaswamy)
              </button>
              <button onclick="applyCitationSample('(1976) 2 SCC 521')" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-rose-100 text-slate-700 hover:text-rose-900 border border-slate-200 hover:border-rose-300 font-mono font-bold transition cursor-pointer">
                🔴 (1976) 2 SCC 521 (ADM Jabalpur - Overruled)
              </button>
              <button onclick="applyCitationSample('(1993) 4 SCC 727')" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-emerald-100 text-slate-700 hover:text-emerald-900 border border-slate-200 hover:border-emerald-300 font-mono font-bold transition cursor-pointer">
                🟢 (1993) 4 SCC 727 (ECIL v. Karunakar)
              </button>
              <button onclick="applyCitationSample('(2008) 4 SCC 54')" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-rose-100 text-slate-700 hover:text-rose-900 border border-slate-200 hover:border-rose-300 font-mono font-bold transition cursor-pointer">
                🔴 (2008) 4 SCC 54 (Krishna Janardhan - Overruled)
              </button>
              <button onclick="applyCitationSample('(2010) 11 SCC 441')" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-emerald-100 text-slate-700 hover:text-emerald-900 border border-slate-200 hover:border-emerald-300 font-mono font-bold transition cursor-pointer">
                🟢 (2010) 11 SCC 441 (Rangappa v. Sri Mohan)
              </button>
            </div>
          </div>
        </div>

        <!-- Citation Verification Dynamic Output Container -->
        <div id="citation-verify-result" class="space-y-6">
          <!-- Populated dynamically by executeSingleCitationVerify() -->
        </div>
      </section>

    <!-- ==================== TAB 2: PLEADING INTAKE & NEURAL OCR ==================== -->
    <section id="tab-intake" class="tab-content hidden space-y-6">
      <!-- Full Access Lock Screen when role is restricted -->
      <div id="intake-lock-screen" class="hidden"></div>

      <!-- Active Content Container (hidden when restricted) -->
      <div id="intake-active-content" class="space-y-6">
        <div class="bg-white rounded-3xl p-4 sm:p-8 court-shadow border border-court-border space-y-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-court-navy tracking-tight">Upload Case &amp; Extract Legal Facts</h2>
          <p class="text-sm text-court-slate mt-1 font-medium">
            Upload digital petitions or scanned legal documents. Automatically extracts facts, issues, and applicable statutes while protecting privacy under the DPDP Act 2023.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          <!-- Interactive Drag & Drop Upload Zone -->
          <div id="pleading-dropzone" 
               class="relative group border-3 border-dashed border-slate-300 hover:border-court-navy rounded-3xl p-8 flex flex-col items-center justify-center text-center bg-slate-50 hover:bg-slate-50/80 transition-all duration-200 cursor-pointer overflow-hidden min-h-[320px]"
               onclick="triggerFileInput(event)"
               ondragenter="handleBriefDragEnter(event)"
               ondragover="handleBriefDragOver(event)"
               ondragleave="handleBriefDragLeave(event)"
               ondrop="handleBriefDrop(event)">
            
            <input type="file" id="file-upload-input" class="hidden" 
                   accept=".pdf,.docx,.doc,.txt,.jpg,.jpeg,.png,.webp,.tiff,.tif,.bmp,image/*" 
                   onchange="handleFileUpload(event)">
            
            <!-- Drag Over Active Overlay -->
            <div id="dropzone-drag-overlay" class="hidden absolute inset-0 bg-amber-500/15 backdrop-blur-xs border-3 border-dashed border-amber-500 rounded-3xl flex flex-col items-center justify-center p-6 z-20 pointer-events-none transition-all">
              <div class="w-20 h-20 rounded-full bg-amber-500 text-white flex items-center justify-center text-4xl shadow-xl animate-bounce mb-3">
                📥
              </div>
              <h4 class="text-lg font-black text-court-navy">Drop Court Brief or Scanned Image Here</h4>
              <p class="text-xs font-bold text-amber-900 mt-1">Automatic Neural OCR, Entity Extraction & DPDP Redaction</p>
            </div>

            <!-- Default Idle Upload State -->
            <div id="dropzone-idle-content" class="flex flex-col items-center justify-center w-full space-y-3">
              <div class="w-16 h-16 rounded-2xl bg-white shadow-md flex items-center justify-center text-3xl border border-slate-200 group-hover:scale-105 transition">
                📂
              </div>
              <div>
                <h3 class="text-base font-extrabold text-court-navy">Upload Court Brief or Scanned Document</h3>
                <p class="text-xs text-court-slate mt-1 max-w-sm">
                  Drag and drop files here, or click to browse local files
                </p>
              </div>

              <!-- Format Support Badges -->
              <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1 pb-1">
                <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-[10.5px] font-bold text-slate-700 shadow-2xs">📄 PDF</span>
                <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-[10.5px] font-bold text-slate-700 shadow-2xs">📝 DOCX</span>
                <span class="px-2.5 py-1 bg-amber-50 border border-amber-300 rounded-lg text-[10.5px] font-extrabold text-amber-900 shadow-2xs">🖼️ JPG / JPEG</span>
                <span class="px-2.5 py-1 bg-amber-50 border border-amber-300 rounded-lg text-[10.5px] font-extrabold text-amber-900 shadow-2xs">🖼️ PNG</span>
                <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-[10.5px] font-bold text-slate-700 shadow-2xs">📷 Scanned Photos</span>
                <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-[10.5px] font-bold text-slate-700 shadow-2xs">📜 TXT</span>
              </div>

              <button type="button" class="px-6 py-2.5 rounded-xl bg-court-navy hover:bg-court-navyLight text-white text-xs font-bold uppercase tracking-wider shadow cursor-pointer transition">
                Select Legal File / Image
              </button>
            </div>

            <!-- File Active / Selected State -->
            <div id="dropzone-file-preview" class="hidden flex flex-col items-center justify-center w-full space-y-3">
              <div class="relative">
                <img id="upload-image-thumbnail" src="" class="hidden w-28 h-28 object-cover rounded-2xl border-2 border-amber-400 shadow-md">
                <div id="upload-doc-icon" class="w-20 h-20 rounded-2xl bg-white shadow-md flex items-center justify-center text-4xl border border-slate-200">
                  📄
                </div>
                <span id="upload-format-badge" class="absolute -top-2 -right-2 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-court-navy text-amber-300 border border-amber-400/50 shadow">
                  IMAGE
                </span>
              </div>

              <div class="max-w-md w-full px-4">
                <h4 id="upload-file-name" class="font-bold text-court-navy text-sm truncate"></h4>
                <p id="upload-file-meta" class="text-xs text-court-slate mt-0.5 font-mono"></p>
                <div id="upload-progress-bar" class="w-full bg-slate-200 rounded-full h-1.5 mt-2 overflow-hidden">
                  <div class="bg-amber-500 h-1.5 rounded-full animate-pulse w-full"></div>
                </div>
              </div>

              <div class="flex items-center gap-2 pt-1">
                <button type="button" onclick="event.stopPropagation(); triggerFileInput(event)" class="px-3.5 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold transition cursor-pointer">
                  ↻ Change File
                </button>
                <button type="button" onclick="event.stopPropagation(); resetFileUpload()" class="px-3.5 py-1.5 rounded-lg bg-rose-100 hover:bg-rose-200 text-rose-800 text-xs font-bold transition cursor-pointer">
                  ✕ Remove
                </button>
              </div>
            </div>

            <p id="file-upload-status" class="text-xs text-emerald-600 mt-2 font-bold"></p>
          </div>

          <!-- Paste Box -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <label class="text-sm font-bold text-court-navy">Pleading Text Input:</label>
              <div class="flex flex-wrap items-center gap-1.5">
                <button type="button" onclick="promptApiKeyInput()" title="Configure Gemini Vision API Key for handwritten documents" class="text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 px-2.5 py-1 rounded-lg transition border border-slate-300 cursor-pointer flex items-center gap-1">
                  <span>🔑</span> <span id="vision-key-badge">Vision AI Key</span>
                </button>
                <button type="button" onclick="loadSampleScannedImage()" class="text-xs font-extrabold text-blue-800 bg-blue-100 hover:bg-blue-200 px-2.5 py-1 rounded-lg transition border border-blue-300 cursor-pointer flex items-center gap-1">
                  <span>📷</span> <span>Test FIR 04/17</span>
                </button>
                <button type="button" onclick="loadSampleFIR06()" class="text-xs font-extrabold text-purple-800 bg-purple-100 hover:bg-purple-200 px-2.5 py-1 rounded-lg transition border border-purple-300 cursor-pointer flex items-center gap-1">
                  <span>📄</span> <span>Test FIR 06/17</span>
                </button>
                <button type="button" onclick="loadDegradedScanBrief()" class="text-xs font-extrabold text-amber-800 bg-amber-100 hover:bg-amber-200 px-2.5 py-1 rounded-lg transition border border-amber-300 cursor-pointer flex items-center gap-1">
                  <span>⚡</span> <span>Degraded Text</span>
                </button>
                <button type="button" onclick="loadSamplePleading()" class="text-xs font-bold text-court-gold hover:underline cursor-pointer">
                  Standard Sample
                </button>
              </div>
            </div>
            <textarea id="pasted-pleading" rows="8" class="w-full bg-slate-50 border-2 border-slate-200 rounded-2xl p-4 text-xs font-mono text-court-navy leading-relaxed outline-none focus:border-court-navy" placeholder="Paste writ petition, plaint, or grounds of appeal here..."></textarea>
            <div class="flex gap-3">
              <button onclick="parsePastedText()" class="flex-1 py-3.5 rounded-xl bg-court-navy hover:bg-court-navyLight text-white font-bold text-xs uppercase tracking-wider shadow transition">
                Extract Entities & Issues
              </button>
              <button onclick="runNeuralOCRCleaning()" class="flex-1 py-3.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs uppercase tracking-wider shadow transition">
                Run Neural OCR & Redact PII
              </button>
            </div>
          </div>

        </div>

        <!-- Extraction Preview Card -->
        <div id="intake-parsed-preview" class="hidden bg-slate-50 p-7 rounded-2xl border-2 border-slate-200 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-3">
            <span class="text-xs font-extrabold text-court-navy uppercase tracking-wider flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              Automated Pleading & Neural Extraction Analysis
            </span>
            <div class="flex items-center space-x-3">
              <span id="redaction-badge" class="px-3 py-1 rounded-lg text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                DPDP Redactions: 0
              </span>
              <button onclick="transferToIntakeStudio()" class="px-6 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold shadow flex items-center space-x-2 transition">
                <span>Transfer to 15-Section Judgment Studio</span>
                <span>➔</span>
              </button>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
            <div>
              <span class="text-xs font-bold text-court-slate uppercase block">Case Information:</span>
              <p id="preview-case-title" class="text-court-navy font-bold text-base mt-1"></p>
              <p id="preview-case-number" class="text-court-gold font-bold text-xs mt-1 font-mono"></p>
              <p id="preview-court" class="text-slate-600 text-xs mt-1"></p>
            </div>
            <div>
              <span class="text-xs font-bold text-court-slate uppercase block">Statutory Grounds:</span>
              <p id="preview-statutes" class="text-slate-800 font-semibold mt-1 text-xs"></p>
            </div>
            <div>
              <span class="text-xs font-bold text-court-slate uppercase block">Framed Legal Questions:</span>
              <p id="preview-issues" class="text-slate-800 mt-1 whitespace-pre-line text-xs font-medium"></p>
            </div>
          </div>
          <div id="sanitized-preview-box" class="hidden mt-3 p-4 bg-white rounded-xl border border-slate-300 font-mono text-xs text-slate-700 max-h-48 overflow-y-auto"></div>
        </div>

      </div>
      </div>
    </section>

    <!-- ==================== TAB 3: 15-SECTION JUDGMENT STUDIO ==================== -->
    <section id="tab-studio" class="tab-content hidden space-y-6">
      
      <!-- Full Access Lock Screen when role is restricted -->
      <div id="studio-lock-screen" class="hidden"></div>

      <!-- Active Content Container (hidden when restricted) -->
      <div id="studio-active-content" class="space-y-6">
        <!-- Top Studio Header & Official Publishing Bar -->
      <div class="bg-white p-5 lg:p-6 rounded-3xl court-shadow border border-court-border flex flex-wrap items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-bold text-court-navy">Draft Judgment (15 Canonical Sections)</h3>
          <p class="text-xs text-court-slate mt-0.5" id="draft-engine-indicator">Status: Ready to draft</p>
        </div>
        
        <div class="flex flex-wrap items-center gap-2.5">
          <button onclick="toggleStudioParamsDrawer()" id="btn-toggle-params-drawer" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-court-navy border border-slate-200 rounded-xl text-xs font-bold flex items-center space-x-1.5 transition">
            <span>⚙️</span><span id="params-drawer-label">Filing Parameters</span><span id="params-drawer-chevron" class="text-[10px] text-slate-400">▼</span>
          </button>
          <button onclick="downloadOfficialDocx()" id="btn-export-docx" disabled class="px-4 py-2 bg-slate-100 text-slate-400 border border-slate-200 rounded-xl text-xs font-bold flex items-center space-x-1.5 transition">
            <span>📄</span><span>Export Court DOCX</span>
          </button>
          <button onclick="openOfficialPrintView()" id="btn-export-print" disabled class="px-4 py-2 bg-slate-100 text-slate-400 border border-slate-200 rounded-xl text-xs font-bold flex items-center space-x-1.5 transition">
            <span>🖨️</span><span>Print Official Gazette</span>
          </button>
          <button onclick="saveCurrentDraft()" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold flex items-center space-x-1.5 shadow transition">
            <span>💾</span><span>Save to Chamber</span>
          </button>
        </div>
      </div>

      <!-- Expandable Case Parameters & Filing Details Drawer (Tucked away by default to eliminate duplication) -->
      <div id="studio-params-drawer" class="hidden bg-white p-6 lg:p-7 rounded-3xl court-shadow border border-court-border space-y-4 transition-all duration-300">
        <div class="flex items-center justify-between border-b border-court-border pb-3">
          <div>
            <h4 class="text-sm font-bold text-court-navy uppercase tracking-wider font-outfit">Original Case Filing Parameters &amp; Re-Synthesis</h4>
            <p class="text-xs text-court-slate mt-0.5">Modify original brief parameters here to re-synthesize from scratch, or simply edit text directly inside the decree below.</p>
          </div>
          <button onclick="toggleStudioParamsDrawer()" class="text-xs font-bold text-slate-400 hover:text-slate-600 px-2.5 py-1 rounded-lg border border-slate-200">
            Close ✕
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div>
            <label class="text-court-navy font-bold block mb-1">Target Court</label>
            <input type="text" id="draft-court" value="High Court of Rajasthan at Jodhpur" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-navy font-semibold outline-none focus:border-court-navy">
          </div>
          <div>
            <label class="text-court-navy font-bold block mb-1">Case Cause Title</label>
            <input type="text" id="draft-title" value="Rajendra Prasad Meena v. State of Rajasthan &amp; Anr." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-navy font-bold outline-none focus:border-court-navy">
          </div>
          <div>
            <label class="text-court-navy font-bold block mb-1">Case / Appeal Number</label>
            <input type="text" id="draft-caseno" value="S.B. Civil Writ Petition No. 4521/2023" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-gold font-mono font-bold outline-none focus:border-court-navy">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <div>
            <label class="text-court-navy font-bold block mb-1">Brief Facts of the Case</label>
            <textarea id="draft-facts" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-navy font-medium outline-none focus:border-court-navy leading-relaxed">The petitioner was serving as Senior Teacher. A departmental disciplinary inquiry was initiated under Rule 16 of Rajasthan CCA Rules. The Inquiry Officer submitted an adverse report directly to the Disciplinary Authority. The Disciplinary Authority dismissed the petitioner without furnishing a copy of the inquiry report or calling for representation.</textarea>
          </div>
          <div>
            <label class="text-court-navy font-bold block mb-1">Applicable Statutory Provisions</label>
            <textarea id="draft-statutes" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-court-navy font-semibold outline-none focus:border-court-navy">Constitution of India, Article 311(2); Rajasthan Civil Services (CCA) Rules, 1958, Rule 16</textarea>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
          <div>
            <label class="text-court-navy font-bold block mb-1">Submissions of Petitioner</label>
            <textarea id="draft-petitioner-args" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-court-navy outline-none">Denial of inquiry report is a fatal breach of natural justice and Article 311(2). Relied upon ECIL v. B. Karunakar (1993) 4 SCC 727.</textarea>
          </div>
          <div>
            <label class="text-court-navy font-bold block mb-1">Submissions of Respondent</label>
            <textarea id="draft-respondent-args" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-court-navy outline-none">Petitioner participated in the oral inquiry. Disciplinary authority has power to agree with inquiry findings.</textarea>
          </div>
          <div>
            <label class="text-court-navy font-bold block mb-1">Issues Framed</label>
            <textarea id="draft-issues" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-court-navy outline-none">Whether non-furnishing of the inquiry report vitiates the final order of dismissal under the principles of natural justice?</textarea>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100">
          <div class="max-w-md w-full">
            <input type="password" id="draft-api-key" placeholder="Gemini API Key (Optional — leave blank for offline neural synthesis)" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-xs text-court-navy outline-none">
          </div>
          <button onclick="generateDraftJudgment()" id="btn-generate-draft" class="px-6 py-2.5 rounded-xl bg-court-navy hover:bg-court-navyLight text-white font-extrabold text-xs uppercase tracking-wider shadow-md flex items-center gap-2 transition cursor-pointer">
            <span>⚡ Re-Synthesize 15-Section Draft Judgment</span>
          </button>
        </div>
      </div>

      <!-- Main Judicial Decree & Intelligence Canvas (Full Width) -->
      <div class="bg-white p-6 lg:p-10 rounded-3xl court-shadow-lg border border-court-border space-y-6">
        
        <div id="draft-placeholder" class="text-center py-24 text-court-slate space-y-4">
          <span class="text-7xl block">📜</span>
          <h4 class="text-xl font-bold text-court-navy">No Draft Active</h4>
          <p class="text-sm max-w-md mx-auto font-medium">Click <strong class="text-court-navy font-bold">"Filing Parameters"</strong> above to enter case details or inspect any case in Search and click <strong class="text-court-navy font-bold">"Transfer to Studio"</strong>.</p>
        </div>

        <!-- Active Draft Sections -->
        <div id="draft-sections-wrapper" class="hidden space-y-6">
          
          <!-- Human Review & Approval Workflow Stepper (Tender SOW Section 12 Compliance) -->
          <div class="bg-gradient-to-r from-court-navyDeep via-slate-900 to-court-navy text-white rounded-2xl p-5 border border-court-gold/40 shadow-md space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-3">
              <div class="flex items-center space-x-2.5">
                <span class="text-xl">⚖️</span>
                <div>
                  <h4 class="font-outfit font-extrabold text-xs uppercase tracking-wider text-amber-300">
                    Decree Governance &amp; Human Approval Workflow (Section 12 SOW)
                  </h4>
                  <p class="text-[11px] text-slate-300 font-medium">
                    Strict human-in-the-loop judicial lifecycle: AI Draft ➔ Clerk Review ➔ Bench Approval ➔ Final Gazette Seal.
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-2">
                <span id="draft-stage-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-400 text-court-navy">
                  ● STAGE: DRAFT
                </span>
                <span id="draft-stage-reviewer" class="text-[11px] font-mono text-slate-300">
                  By: Hon'ble Presiding Judge
                </span>
              </div>
            </div>

            <!-- 4-Stage Stepper Track -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 pt-1 text-xs">
              <div id="step-node-DRAFT" class="p-2.5 rounded-xl bg-amber-400/20 border border-amber-400/50 text-amber-300 font-semibold flex items-center space-x-2">
                <span class="w-5 h-5 rounded-full bg-amber-400 text-court-navy flex items-center justify-center font-bold text-[10px]">1</span>
                <div>
                  <div class="font-bold text-[11px] text-white">AI Initial Synthesis</div>
                  <div class="text-[9.5px] text-amber-200">15 Canonical Sections</div>
                </div>
              </div>

              <div id="step-node-CLERK_REVIEW" class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-400 font-semibold flex items-center space-x-2">
                <span class="w-5 h-5 rounded-full bg-white/10 text-slate-300 flex items-center justify-center font-bold text-[10px]">2</span>
                <div>
                  <div class="font-bold text-[11px] text-slate-200">Law Clerk Review</div>
                  <div class="text-[9.5px] text-slate-400">Precedent Verification</div>
                </div>
              </div>

              <div id="step-node-BENCH_APPROVED" class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-400 font-semibold flex items-center space-x-2">
                <span class="w-5 h-5 rounded-full bg-white/10 text-slate-300 flex items-center justify-center font-bold text-[10px]">3</span>
                <div>
                  <div class="font-bold text-[11px] text-slate-200">Bench Approval</div>
                  <div class="text-[9.5px] text-slate-400">Judicial Concurrence</div>
                </div>
              </div>

              <div id="step-node-FINAL_SEALED" class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-slate-400 font-semibold flex items-center space-x-2">
                <span class="w-5 h-5 rounded-full bg-white/10 text-slate-300 flex items-center justify-center font-bold text-[10px]">4</span>
                <div>
                  <div class="font-bold text-[11px] text-slate-200">Gazette Final Sign-off</div>
                  <div class="text-[9.5px] text-slate-400">SHA-256 Sealed Decree</div>
                </div>
              </div>
            </div>

            <!-- Workflow Stage Action Buttons -->
            <div class="pt-1 flex flex-wrap items-center justify-between gap-3 text-xs border-t border-white/10">
              <span class="text-slate-400 text-[11px]">Advance stage in accordance with accredited role authorization:</span>
              <div class="flex flex-wrap items-center gap-2">
                <button id="btn-stage-clerk" onclick="advanceDraftStage('CLERK_REVIEW')" class="px-3 py-1.5 rounded-lg bg-blue-600/80 hover:bg-blue-600 text-white font-bold transition flex items-center gap-1 cursor-pointer">
                  <span>🧑‍⚖️</span> <span>Submit to Clerk Review</span>
                </button>
                <button id="btn-stage-bench" onclick="advanceDraftStage('BENCH_APPROVED')" class="px-3 py-1.5 rounded-lg bg-emerald-600/80 hover:bg-emerald-600 text-white font-bold transition flex items-center gap-1 cursor-pointer">
                  <span>⚖️</span> <span>Judicial Bench Approval</span>
                </button>
                <button id="btn-stage-seal" onclick="advanceDraftStage('FINAL_SEALED')" class="px-3 py-1.5 rounded-lg bg-amber-400 hover:bg-amber-300 text-court-navy font-black transition flex items-center gap-1 shadow cursor-pointer">
                  <span>🔏</span> <span>Final Gazette Seal</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Live Editable Banner with Font Size Controls -->
          <div class="p-3.5 rounded-2xl bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border border-amber-300/80 flex flex-wrap items-center justify-between gap-3 text-xs text-court-navy">
            <div class="flex items-center space-x-2">
              <span class="text-base">✏️</span>
              <span class="font-extrabold font-outfit text-sm">Live Judicial Decree Editor:</span>
              <span class="text-slate-600 font-medium text-xs">All 15 canonical sections below are live editable.</span>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <div class="flex items-center bg-white border border-slate-300 rounded-xl px-2.5 py-1 shadow-xs gap-1.5" title="Adjust decree typography for comfortable reading">
                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mr-1">Font Size:</span>
                <button onclick="setDecreeFontSize('normal')" id="btn-font-normal" class="px-2.5 py-1 rounded-lg text-xs font-bold transition bg-court-navy text-white cursor-pointer">A Standard</button>
                <button onclick="setDecreeFontSize('large')" id="btn-font-large" class="px-2.5 py-1 rounded-lg text-xs font-bold transition bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer">A+ Large</button>
                <button onclick="setDecreeFontSize('xlarge')" id="btn-font-xlarge" class="px-2.5 py-1 rounded-lg text-xs font-bold transition bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer">A++ Extra Large</button>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold">Auto-Synced on Save</span>
            </div>
          </div>

              <!-- Side-by-Side: 15-Section Decree + Judicial Reasoning & Precedents Matrix -->
              <div class="grid grid-cols-1 2xl:grid-cols-12 gap-6">
                
                <!-- Left: 15-Section Canonical Judicial Decree Canvas -->
                <div class="2xl:col-span-7 space-y-6">
                  
                  <div id="printable-judicial-decree" class="space-y-6">
                    <!-- Case Decree Header -->
                    <div class="text-center border-b-2 border-slate-200 pb-6 space-y-2">
                      <p class="text-xs uppercase tracking-widest text-court-slate font-extrabold">National Law University, Jodhpur • Official Judicial Research Prototype</p>
                      <h2 id="sec-1-title" class="text-2xl font-bold text-court-navy"></h2>
                      <p id="sec-2-caseno" class="text-sm text-court-gold font-mono font-bold"></p>
                    </div>

                    <!-- 15 Sections Output Area (Live Editable) -->
                    <div id="sections-content-container" class="space-y-6"></div>
                  </div>

                  <!-- Digital Integrity Seal Box -->
                  <div class="p-5 rounded-2xl bg-slate-50 border-2 border-slate-300 font-mono text-xs text-slate-700 space-y-1">
                    <div class="flex items-center justify-between text-court-navy font-bold">
                      <span>INSTITUTIONAL DIGITAL INTEGRITY SEAL</span>
                      <span class="text-emerald-600">✓ VERIFIED_ACTIVE_CANONICAL</span>
                    </div>
                    <p>SHA-256 Fingerprint: <span id="judgment-sha256" class="text-court-gold font-bold">SHA256-PENDING-SAVE</span></p>
                    <p>Compliance: Section 65B Indian Evidence Act / Section 63 Bharatiya Sakshya Adhiniyam, 2023</p>
                  </div>

                </div>

                <!-- Right: Judicial Reasoning & Solved Precedent Matrix (Beside the Judgment) -->
                <div class="2xl:col-span-5 space-y-5">
                  
                  <!-- 1. Why This Judgment Was Given (Judicial Ratio & Determination Grounds) -->
                  <div class="bg-slate-50/90 rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                      <div class="flex items-center space-x-2">
                        <span class="text-base">⚖️</span>
                        <h4 class="font-outfit font-black text-xs uppercase tracking-wider text-court-navy">
                          Why Judgment Was Given (Judicial Ratio)
                        </h4>
                      </div>
                      <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                        Grounds of Decree
                      </span>
                    </div>
                    <div id="studio-reasons-container" class="space-y-2.5 text-xs text-slate-700">
                      <!-- Populated dynamically with the core reasoning -->
                    </div>
                  </div>

                  <!-- 2. History of Solved Cases on Same Applicable Sections -->
                  <div class="bg-slate-50/90 rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                      <div class="flex items-center space-x-2">
                        <span class="text-base">🏛️</span>
                        <h4 class="font-outfit font-black text-xs uppercase tracking-wider text-court-navy">
                          Applicable Sections: Solved Precedents
                        </h4>
                      </div>
                      <span class="text-[10px] font-mono font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded" id="studio-statute-match-count">
                        History
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-500 font-medium leading-relaxed">
                      Solved precedents from the 1.18 Lakh database interpreting the same applicable sections:
                    </p>
                    <div id="studio-solved-cases-container" class="space-y-2.5 max-h-[460px] overflow-y-auto pr-1">
                      <!-- Populated dynamically with precedent cards + ratio + Insert Precedent button -->
                    </div>
                  </div>

                  <!-- 3. Automated Citation Verification Audit Card -->
                  <div class="bg-slate-50/90 rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                      <h4 class="text-xs font-black uppercase tracking-wider text-court-navy flex items-center gap-1.5 font-outfit">
                        <span class="text-emerald-600">✓</span>
                        <span>Tender Sec. 8 Citation Verification</span>
                      </h4>
                      <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
