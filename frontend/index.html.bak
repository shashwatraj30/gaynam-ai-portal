    function switchLineageStream(streamKey) {
      document.querySelectorAll('.stream-btn').forEach(btn => {
        btn.classList.remove('bg-court-navy', 'text-white');
        btn.classList.add('bg-slate-100', 'text-court-navy');
      });
      const activeBtn = document.getElementById('btn-stream-' + streamKey);
      if (activeBtn) {
        activeBtn.classList.remove('bg-slate-100', 'text-court-navy');
        activeBtn.classList.add('bg-court-navy', 'text-white');
      }

      const stream = LINEAGE_STREAMS[streamKey];
      if (!stream) return;

      document.getElementById('lineage-stream-title').innerText = stream.title;
      document.getElementById('lineage-stream-subtitle').innerText = stream.subtitle;

      const container = document.getElementById('lineage-nodes-container');
      container.innerHTML = stream.nodes.map((node, idx) => {
        const isLast = idx === stream.nodes.length - 1;
        return `
          <div class="relative flex items-start space-x-6">
            <div class="flex flex-col items-center">
              <div class="w-14 h-14 rounded-2xl bg-court-navy text-white font-mono font-black text-base flex items-center justify-center shadow-xl border-2 border-court-gold">
                ${node.year}
              </div>
              ${!isLast ? '<div class="w-1.5 h-24 bg-slate-300 mt-2"></div>' : ''}
            </div>

            <div class="flex-1 bg-slate-50 hover:bg-white p-7 rounded-3xl border-2 border-slate-200 hover:border-court-navy transition court-shadow space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="px-3.5 py-1 rounded-full text-xs font-bold border ${node.badgeClass}">
                  ${node.statusLabel}
                </span>
                <span class="text-xs font-mono font-bold text-slate-500 bg-white px-2.5 py-1 rounded-md border border-slate-200">${node.impact}</span>
              </div>

              <h4 class="text-xl font-bold text-court-navy mt-1">${node.title}</h4>
              <p class="text-sm font-mono font-bold text-court-gold">${node.citation} • <span class="font-sans font-medium text-slate-600">${node.court}</span></p>
              <p class="text-xs text-slate-600"><strong class="text-court-navy">Presiding Coram:</strong> ${node.bench}</p>
              <p class="text-xs text-slate-800 leading-relaxed font-medium pt-2 border-t border-slate-200 mt-2 legal-serif text-sm">${node.desc}</p>
            </div>
          </div>
        `;
      }).join('');
    }

    // Audit logs & Cryptographic Ledger
    async function loadAuditLogs() {
      try {
        const resp = await fetch('/api/audit_logs');
        const logs = await resp.json();
        const tbody = document.getElementById('audit-table-body');
        tbody.innerHTML = logs.map(l => `
          <tr class="hover:bg-slate-50">
            <td class="p-4 text-slate-500 font-bold">${l.timestamp}</td>
            <td class="p-4 font-bold text-court-navy">${l.user_role}</td>
            <td class="p-4 font-extrabold text-court-gold">${l.action}</td>
            <td class="p-4 text-slate-700 truncate max-w-xs">${l.details}</td>
            <td class="p-4 text-slate-400 font-mono">${l.ip_address}</td>
          </tr>
        `).join('');
      } catch (e) {
        console.error("Failed to load audit logs", e);
      }
    }

    async function verifyLedgerIntegrity() {
      const statusP = document.getElementById('ledger-verify-status');
      statusP.innerText = "Verifying cryptographic chain...";
      try {
        const resp = await fetch('/api/audit/ledger/verify');
        const data = await resp.json();
        if (data.status === 'VERIFIED_SECURE') {
          statusP.innerText = `✓ ${data.total_blocks_verified} Blocks Verified (SHA-256 Chain Intact)`;
          alert(`Cryptographic Audit Chain Integrity: 100% VERIFIED!\n\nTotal Blocks Verified: ${data.total_blocks_verified}\nLatest Block Hash: ${data.latest_block_hash.substring(0, 24)}...\nStandard: DPDP Act 2023 §8(4) & Indian Evidence Act §65B`);
        } else {
          statusP.innerText = "⚠️ Compromised Ledger Block Detected";
          alert("Audit Ledger Warning: " + data.message);
        }
      } catch (e) {
        statusP.innerText = "Verification check failed";
      }
    }

    // ==================== SEAMLESS SCROLL ANIMATION FOR GRAND HEADER ====================
    let isHeroCollapsed = false;
    let manualToggleActive = false;

    function handleScrollAnimation() {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      
      // If user returns to top of page, reset manual toggle and restore grand header
      if (scrollY <= 15) {
        manualToggleActive = false;
        if (isHeroCollapsed) {
          expandCampusHero();
        }
        return;
      }

      // If user manually clicked "Campus View" or "Expand Header", respect their choice until they scroll back to top
      if (manualToggleActive) return;

      // When scrolling down past 50px: smoothly glide the grand hero up
      if (scrollY > 50 && !isHeroCollapsed) {
        collapseCampusHero();
      } 
      // When scrolling back near the top: smoothly glide the grand hero back down
      else if (scrollY <= 25 && isHeroCollapsed) {
        expandCampusHero();
      }
    }

    function collapseCampusHero() {
      const hero = document.getElementById('grand-hero-container');
      const miniBrand = document.getElementById('sticky-mini-brand');
      const chevron = document.getElementById('hero-toggle-chevron');
      const toggleText = document.getElementById('hero-toggle-text');

      if (!hero) return;
      hero.classList.add('hero-collapsed');
      isHeroCollapsed = true;

      if (miniBrand) {
        miniBrand.classList.remove('opacity-0', '-translate-x-3', 'pointer-events-none', 'w-0');
        miniBrand.classList.add('opacity-100', 'translate-x-0', 'w-auto');
      }
      if (chevron) chevron.style.transform = 'rotate(180deg)';
      if (toggleText) toggleText.textContent = 'Expand Header';
    }

    function expandCampusHero() {
      const hero = document.getElementById('grand-hero-container');
      const miniBrand = document.getElementById('sticky-mini-brand');
      const chevron = document.getElementById('hero-toggle-chevron');
      const toggleText = document.getElementById('hero-toggle-text');

      if (!hero) return;
      hero.classList.remove('hero-collapsed');
      isHeroCollapsed = false;

      if (miniBrand) {
        miniBrand.classList.remove('opacity-100', 'translate-x-0', 'w-auto');
        miniBrand.classList.add('opacity-0', '-translate-x-3', 'pointer-events-none', 'w-0');
      }
      if (chevron) chevron.style.transform = 'rotate(0deg)';
      if (toggleText) toggleText.textContent = 'Campus View';
    }

    function toggleCampusHero() {
      manualToggleActive = true;
      if (isHeroCollapsed) {
        expandCampusHero();
      } else {
        collapseCampusHero();
      }
    }

    window.addEventListener('scroll', () => {
      requestAnimationFrame(handleScrollAnimation);
    }, { passive: true });

    async function loadSystemStatus() {
      try {
        const resp = await fetch('/api/status');
        const data = await resp.json();
        if (data.total_judgments_indexed) {
          const formatted = Number(data.total_judgments_indexed).toLocaleString('en-IN');
          const counterEl = document.getElementById('header-db-counter');
          if (counterEl) counterEl.innerText = `${formatted} Decisions Active`;
          const stickyEl = document.getElementById('sticky-db-counter');
          if (stickyEl) stickyEl.innerText = `${formatted} Decisions Active`;
          const ftsBadge = document.getElementById('search-fts-badge');
          if (ftsBadge) ftsBadge.innerText = `${formatted} Judgments Indexed`;
          const compCount = document.getElementById('compliance-db-count');
          if (compCount) compCount.innerText = `Indexed: ${formatted} verified authentic judicial records (Official e-SCR/eCourts).`;
        }
      } catch (e) {
        console.error("Telemetry fetch failed", e);
      }
    }

    // Auto-run initial search, set role and load live telemetry
    window.onload = async () => {
      // Restore sidebar retracted state preference
      try {
        const savedRetract = localStorage.getItem('gyanam_sidebar_retracted');
        if (savedRetract === 'true') {
          const sidebar = document.getElementById('app-sidebar');
          if (sidebar) sidebar.classList.add('sidebar-retracted');
          if (typeof updateSidebarRetractUI === 'function') updateSidebarRetractUI(true);
        }
      } catch (e) {}

      if (window.location.hash.includes('retract=true')) {
        const sidebar = document.getElementById('app-sidebar');
        if (sidebar) sidebar.classList.add('sidebar-retracted');
        if (typeof updateSidebarRetractUI === 'function') updateSidebarRetractUI(true);
      }

      loadSystemStatus();
      
      // Sync stored Gemini API Key
      try {
        let storedKey = localStorage.getItem('gemini_api_key');
        if (!storedKey) {
          storedKey = 'REDACTED-LEAKED-KEY';
          localStorage.setItem('gemini_api_key', storedKey);
        }
        const keyInp = document.getElementById('draft-api-key');
        if (storedKey && keyInp) {
          keyInp.value = storedKey;
        }
        if (keyInp) {
          keyInp.addEventListener('input', (e) => {
            localStorage.setItem('gemini_api_key', e.target.value.trim());
            updateVisionKeyBadge();
          });
        }
        updateVisionKeyBadge();
      } catch (e) {}

      // Initial search will only run when user submits query or selects benchmark
      switchLineageStream('privacy');

      const hash = window.location.hash;
      let initialRole = 'JUDICIAL_USER';
      if (hash === '#auditor') initialRole = 'AUDITOR';
      else if (hash === '#researcher') initialRole = 'RESEARCHER';
      else if (hash === '#faculty') initialRole = 'FACULTY';
      else if (hash === '#student') initialRole = 'STUDENT';
      else if (hash === '#admin') initialRole = 'ADMINISTRATOR';
      
      await switchJudicialRole(initialRole);
      renderLiveCasesStream();

      if (hash.includes('q=')) {
        const queryMatch = hash.match(/q=([^&]+)/);
        if (queryMatch) {
          const qVal = decodeURIComponent(queryMatch[1]);
          document.getElementById('search-input').value = qVal;
          setTimeout(() => { executeSearch(); }, 200);
        }
      }

      if (hash.startsWith('#studio') || hash.startsWith('#draft')) {
        switchTab('tab-studio');
        if (typeof collapseCampusHero === 'function') collapseCampusHero();
        setTimeout(() => { const el = document.getElementById('tab-studio'); if (el) el.scrollIntoView({ behavior: 'smooth' }); }, 100);
        if (hash.includes('generate=true')) {
          setTimeout(() => { generateDraftJudgment(); }, 400);
        }
      } else if (hash.startsWith('#intake')) {
        switchTab('tab-intake');
        if (typeof collapseCampusHero === 'function') collapseCampusHero();
        setTimeout(() => { const el = document.getElementById('tab-intake'); if (el) el.scrollIntoView({ behavior: 'smooth' }); }, 100);
        if (hash.includes('sample_img=true')) {
          setTimeout(() => { loadSampleScannedImage(); }, 300);
        }
      } else if (hash.startsWith('#lineage') || hash.startsWith('#graph')) {
        switchTab('tab-graph');
        if (typeof collapseCampusHero === 'function') collapseCampusHero();
        setTimeout(() => { const el = document.getElementById('tab-graph'); if (el) el.scrollIntoView({ behavior: 'smooth' }); }, 100);
      } else if (hash.startsWith('#audit')) {
        switchTab('tab-audit');
        if (typeof collapseCampusHero === 'function') collapseCampusHero();
        if (hash.includes('users=true')) {
          setTimeout(() => switchAuditSubTab('users'), 150);
        } else if (hash.includes('reports=true')) {
          setTimeout(() => switchAuditSubTab('reports'), 150);
        }
        setTimeout(() => { const el = document.getElementById('tab-audit'); if (el) el.scrollIntoView({ behavior: 'smooth' }); }, 100);
      } else if (hash.startsWith('#dashboard')) {
        switchTab('tab-dashboard');
        setTimeout(() => { const el = document.getElementById('tab-dashboard'); if (el) el.scrollIntoView({ behavior: 'smooth' }); }, 100);
      } else if (hash.startsWith('#citation')) {
        switchTab('tab-citation');
        const citMatch = hash.match(/q=([^&]+)/);
        if (citMatch) {
          const cVal = decodeURIComponent(citMatch[1]);
          const citInp = document.getElementById('citation-input');
          if (citInp) citInp.value = cVal;
          setTimeout(() => executeSingleCitationVerify(), 250);
        }
        setTimeout(() => { const el = document.getElementById('tab-citation'); if (el) el.scrollIntoView({ behavior: 'smooth' }); }, 100);
      }

      if (hash.startsWith('#inspect=')) {
        const parts = hash.replace('#inspect=', '').split('&');
        const id = parts[0];
        const tabParam = parts.find(p => p.startsWith('tab='));
        viewJudgment(id).then(() => {
          if (tabParam) {
            const t = tabParam.replace('tab=', '');
            switchDossierTab(t);
          }
        });
      }

      if (hash.startsWith('#transfer=')) {
        const id = hash.replace('#transfer=', '').split('&')[0];
        viewJudgment(id).then(() => {
          setTimeout(() => {
            transferPrecedentToStudio();
          }, 350);
        });
      }

      // Show Institutional SSO modal on initial visit unless in direct preview
      if (!sessionStorage.getItem('gyanam_session_active') && (!hash || hash === '')) {
        openAuthModal();
      }
    };
  </script>
</body>
</html>
