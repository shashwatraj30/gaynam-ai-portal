                <span class="text-[10px] font-black px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 border border-emerald-200 shrink-0">ADMIN</span>
              </div>
              <div class="mt-2.5 pt-2.5 border-t border-slate-100 text-[10.5px] text-slate-600 space-y-1">
                <div class="font-mono text-[9.5px] text-slate-500">NLUJ-FAC-014 • University Secretariat</div>
                <div class="text-emerald-800 font-extrabold">✓ SOW: Complete System Administration &amp; Telemetry</div>
              </div>
            </div>

            <!-- Role 6: Auditor -->
            <div onclick="selectAuthRole('AUDITOR')" id="role-card-AUDITOR" class="role-auth-card cursor-pointer p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-slate-300 shadow-sm transition-all duration-200 hover:scale-[1.01]">
              <div class="flex items-start justify-between">
                <div class="flex items-center space-x-2.5">
                  <span class="text-2xl p-2 rounded-xl bg-rose-100 text-rose-800">🛡️</span>
                  <div>
                    <h4 class="font-black text-xs sm:text-sm text-court-navy font-outfit">CA Rajeshwar Singhal</h4>
                    <p class="text-[10px] text-rose-900 font-bold uppercase tracking-wider">Institutional Auditor</p>
                  </div>
                </div>
                <span class="text-[10px] font-black px-2 py-0.5 rounded bg-rose-100 text-rose-800 border border-rose-200 shrink-0">AUDITOR</span>
              </div>
              <div class="mt-2.5 pt-2.5 border-t border-slate-100 text-[10.5px] text-slate-600 space-y-1">
                <div class="font-mono text-[9.5px] text-slate-500">NLUJ-AUD-007 • Internal Audit Bureau</div>
                <div class="text-rose-800 font-extrabold">✓ SOW: Logs &amp; Audit Information (Cryptographic Chain)</div>
              </div>
            </div>

          </div>
        </div>

        <!-- Bottom Action Button & Security Notice -->
        <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center space-x-2 text-xs text-slate-500 font-medium">
            <span class="text-emerald-600 text-base">🛡️</span>
            <span>DPDP Act 2023 Compliant • On-Premise Air-Gapped Session</span>
          </div>
          <button onclick="confirmAuthSignIn()" id="btn-confirm-auth" class="w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-court-navy to-slate-900 hover:from-slate-900 hover:to-court-navy text-white font-outfit font-extrabold text-sm rounded-2xl shadow-xl transition-all flex items-center justify-center space-x-2">
            <span>Sign In to Judicial Workbench</span>
            <span>➔</span>
          </button>
        </div>

      </div>

    </div>
  </div>

  <!-- APPLICATION LOGIC & LINEAGE ENGINE -->
